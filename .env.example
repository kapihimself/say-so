# Copy this file to `.env.local` and fill in your own values.
# `.env.local` is git-ignored — never commit real keys.

# ---------------------------------------------------------------------------
# Supabase — project used for auth + the `english` schema progress storage.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Used by lib/supabase/admin.ts to write progress. Keep secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_PROJECT_ID=your-project-ref

# ---------------------------------------------------------------------------
# Chat teacher — any OpenAI-compatible endpoint (streaming chat completions).
# ---------------------------------------------------------------------------
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=your-chat-api-key
AI_CHAT_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Speech-to-text (voice input) — OpenAI-compatible transcription endpoint.
# ---------------------------------------------------------------------------
STT_BASE_URL=https://api.openai.com/v1
STT_API_KEY=your-stt-api-key
STT_MODEL=gpt-4o-mini-transcribe

# ---------------------------------------------------------------------------
# Text-to-speech (AI teacher voice) — OpenAI-compatible TTS endpoint.
# ---------------------------------------------------------------------------
TTS_BASE_URL=https://api.openai.com/v1
TTS_API_KEY=your-tts-api-key
TTS_MODEL=gpt-4o-mini-tts

# ---------------------------------------------------------------------------
# Pre-recorded narration ingestion — only needed for `npm run gen:tts`.
# ---------------------------------------------------------------------------
OPENAI_TTS_KEY=your-openai-key
